{
  "id": "/app/",
  "name": "Koonfy — CRM de WhatsApp",
  "short_name": "Koonfy",
  "description": "CRM de WhatsApp com atendimento, automações e campanhas.",
  "start_url": "/app/?src=pwa",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#ECFDF5",
  "theme_color": "#34D399",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/assets/koonfy-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/koonfy-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/koonfy-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/koonfy-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Conversas", "short_name": "Inbox", "url": "/app/?src=pwa#/inbox", "icons": [{ "src": "/assets/koonfy-192.png", "sizes": "192x192" }] },
    { "name": "Agenda", "short_name": "Agenda", "url": "/app/?src=pwa#/schedule", "icons": [{ "src": "/assets/koonfy-192.png", "sizes": "192x192" }] },
    { "name": "Automações", "short_name": "Flows", "url": "/app/?src=pwa#/flows", "icons": [{ "src": "/assets/koonfy-192.png", "sizes": "192x192" }] }
  ]
}
