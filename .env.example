# Porta do servidor (opcional — padrão 3900)
PORT=3900

# Observação: as credenciais sensíveis (token do WhatsApp, Woovi, senha admin,
# chaves VAPID) NÃO ficam em variáveis de ambiente — são configuradas pela própria
# interface (Admin SaaS / Configurações) e persistidas em data/db.json,
# que está fora do versionamento (.gitignore).

# ---------------------------------------------------------------------------
# APPS iOS / ANDROID (App Store e Play Store)
# Só necessário se você publicar os aplicativos. Ver mobile/README.md.
# ---------------------------------------------------------------------------

# Origens extras liberadas no CORS, separadas por vírgula. As origens dos apps
# nativos (capacitor://localhost e https://localhost) já são liberadas por
# padrão — use isto apenas para outros domínios, se precisar.
# CORS_ORIGINS=https://outro.seudominio.com

# --- Push do app Android (Firebase Cloud Messaging) ---
# JSON da service account do Firebase, inteiro numa linha, ou o caminho do arquivo.
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# FCM_SERVICE_ACCOUNT_FILE=/etc/elitechat/fcm-service-account.json

# --- Push do app iOS (APNs — sem Firebase) ---
# Chave .p8 criada em developer.apple.com → Keys.
# APNS_KEY_FILE=/etc/elitechat/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=YYYYYYYYYY
# APNS_BUNDLE_ID=com.elitechat.app
# APNS_ENV=production
